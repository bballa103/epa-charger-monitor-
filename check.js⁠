const { chromium } = require('playwright');

const NTFY_TOPIC = 'epa-rtp-charger-63737';
const STATION_URL = 'https://driver.chargepoint.com/stations/3075301';

(async () => {
  const browser = await chromium.launch({ headless: true });
  const page = await browser.newPage();

  console.log('Loading ChargePoint station 3075301...');
  await page.goto(STATION_URL, { waitUntil: 'domcontentloaded', timeout: 60000 });
  
  // Wait 10 seconds for ChargePoint's live port statuses to populate on screen
  await page.waitForTimeout(10000);

  const bodyText = await page.innerText('body');
  console.log('Extracted status text:\n', bodyText);

  if (bodyText.includes('Available')) {
    console.log('Port Available! Sending push notification...');
    await fetch(`https://ntfy.sh/${NTFY_TOPIC}`, {
      method: 'POST',
      body: 'EPA-RTP N. Surface Lot charger has an AVAILABLE port!',
      headers: {
        'Title': 'EPA Charger Available!',
        'Priority': 'high',
        'Tags': 'electric_plug,car'
      }
    });
  } else if (process.env.EVENT_NAME === 'workflow_dispatch') {
    console.log('Manual test run: Both ports In Use, sending test confirmation to iPhone...');
    await fetch(`https://ntfy.sh/${NTFY_TOPIC}`, {
      method: 'POST',
      body: 'GitHub Monitor is working! Both EPA-RTP ports are currently In Use.',
      headers: {
        'Title': 'Charger Monitor Connected',
        'Priority': 'default',
        'Tags': 'white_check_mark'
      }
    });
  } else {
    console.log('Both ports are currently In Use.');
  }

  await browser.close();
})();
